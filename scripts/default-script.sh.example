#!/bin/sh
# default-script.sh.example — reference implementation.
#
# Don't run this directly — run ./bootstrap/run.sh, which copies this to
# bootstrap/default-script.sh (gitignored, yours to adapt) and executes it.
#
# Contract: docs/design/BOOTSTRAP_PIPELINE.md §2.
#   - POSIX sh only. No bashisms, no jq, no GNU-only flags.
#   - No Python. Stage zero measures whether an interpreter exists; it cannot
#     be written in one.
#   - Installs nothing. Measures only.
#   - A failed probe is a finding, never a fatal error.
#   - Every fact carries the command that produced it.
#
# This file is the dispatcher. The probes live in scripts/os/ — a portable
# core plus one script per OS, because the probes genuinely differ and a
# single script that tries to cover every OS is wrong everywhere instead of
# right somewhere.
#
# Writes default-results.md. No AI runs this.

set -u

OUT="${1:-default-results.md}"

# Where the probe scripts live. Overridable so an adapted copy in bootstrap/
# can still find them, and so tests can point at fixtures.
here=$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd)
if [ -d "$here/os" ]; then
  OS_DIR="${FERRET_OS_DIR:-$here/os}"
else
  # We're the seeded copy in bootstrap/; the probes stay in scripts/.
  OS_DIR="${FERRET_OS_DIR:-$(dirname -- "$here")/scripts/os}"
fi

if [ ! -r "$OS_DIR/common.sh" ]; then
  echo "default-script: missing $OS_DIR/common.sh" >&2
  exit 1
fi

# shellcheck source=scripts/os/common.sh
. "$OS_DIR/common.sh"

# --- dispatch --------------------------------------------------------------
# Lowercase uname without tr -- some busybox builds differ on tr ranges.
uname_s=$(uname -s 2>/dev/null || echo unknown)
case "$uname_s" in
  Darwin)  os_key=darwin ;;
  Linux)   os_key=linux ;;
  *)       os_key="" ;;
esac

OS_SCRIPT=""
if [ -n "$os_key" ] && [ -r "$OS_DIR/$os_key.sh" ]; then
  OS_SCRIPT="$os_key.sh"
fi

common_header

if [ -n "$OS_SCRIPT" ]; then
  # shellcheck source=/dev/null
  . "$OS_DIR/$OS_SCRIPT"
  row "os-support" "$os_key" "-" "$OS_DIR/$OS_SCRIPT" "uname -s"
  probe_os
else
  # An unrecognized OS is a finding, not a crash — and not a guess at the
  # nearest match. A Linux script run on a BSD produces confident wrong
  # answers, which is the failure mode this tool exists to prevent.
  row "os-support" "unknown ($uname_s)" "-" "-" "uname -s"
  probe_common
fi

common_footer

# Exit 0 even when probes failed. A missing tool is a finding, not an error.
exit 0
